# config/gcp.env — the ONLY place where cloud parameters live (sourced by scripts/gcp.sh).
# Fill PROJECT_ID with the Project ID authorized for the course (not the project *name*).
PROJECT_ID="${PROJECT_ID:-arctic-kiln-510814-c8}"   # team project "Cloud Optimization"
ZONE="${ZONE:-europe-west1-b}"            # Belgium; zone of the team VMs cloudopt-vm1..3 (see D13)
MACHINE_TYPE="${MACHINE_TYPE:-e2-medium}"         # type of the existing team VMs (shared-core, see D13)
VM_NAME="${VM_NAME:-cloudopt-vm1}"
IMAGE_FAMILY="ubuntu-2404-lts-amd64"               # TD image, used only by `create`; team VMs run Debian 13 (D13)
IMAGE_PROJECT="ubuntu-os-cloud"
BOOT_DISK_SIZE="10GB"                              # used only by `create`; existing VMs have 10 GB
BOOT_DISK_TYPE="pd-balanced"
LABELS="course=cloud-optimization,td=td2"
# TD3: the worker VMs of the distributed execution (scripts/deploy_all.sh, gcp.sh start-all/stop-all)
VMS="${VMS:-cloudopt-vm1 cloudopt-vm2 cloudopt-vm3}"
# Tag used in data file names: cloudopt-vm1 -> cloud_vm1 -> data/benchmark_cloud_vm1.csv
TAG="${TAG:-cloud_${VM_NAME#cloudopt-}}"
